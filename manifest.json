{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "FB Verified Badge",
  "version": "1.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/binhake/Facebook_Verified_Badge",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.facebook.com/*",
        "*://web.facebook.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
